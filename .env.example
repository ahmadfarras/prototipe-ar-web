# --- Database ---
POSTGRES_USER=ar
POSTGRES_DB=ar
POSTGRES_PASSWORD=

DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
HOST=0.0.0.0
COOKIE_SECURE=true
# The web container is the API's only client and sets X-Forwarded-For itself.
TRUST_PROXY=true

# --- Web ---
# Port on 127.0.0.1 that the server's nginx proxies to.
WEB_PORT=8090

# To run the API on your own machine instead (npm run api:dev, make migrate,
# make seed), use these values in your local .env:
#   DATABASE_URL=postgres://ar:<password>@127.0.0.1:54329/ar
#   HOST=127.0.0.1
#   COOKIE_SECURE=false
#   TRUST_PROXY=false
